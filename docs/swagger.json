        "/api/v1/roles/{purpose}/key": {
            "get": {
                "security": [
                    {
                        "ServiceKey": []
                    }
                ],
                "description": "Returns current key of role, e.g. gas station. Key changes after rotation, so do not store key id in config.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "keys"
                ],
                "summary": "Get active key of own single role",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Role purpose, e.g. gas_station",
                        "name": "purpose",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Purpose refinement, e.g. atoken, usdt_high_risk",
                        "name": "label",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Network: ethereum, tron, arbitrum",
                        "name": "network",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/httputil.Response"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
