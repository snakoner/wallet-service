        "/api/v1/admin/roles/{id}/policy": {
            "put": {
                "description": "Applies to all keys of role. Format is described in docs/POLICY.md. Empty rules deny signing.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "admin"
                ],
                "summary": "Replace signing policy of role",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Role id",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Policy",
                        "name": "request",
                        "in": "body",
                        "required": true,
