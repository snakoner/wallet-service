        "/api/v1/keys/{id}/sign-transaction": {
            "post": {
                "security": [
                    {
                        "ServiceKey": []
                    }
                ],
                "description": "Signs unsigned tx with own key. Tx is built and sent by the caller.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "signing"
                ],
                "summary": "Sign transaction",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Key id",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Unsigned tx",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/signing.SignTransactionRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/httputil.Response"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/signing.SignTransactionResponse"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "400": {
                        "description": "Bad Request",
