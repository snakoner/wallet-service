                "id": {
                    "type": "string"
                },
                "kind": {
                    "type": "string"
                },
                "label": {
                    "type": "string"
                },
                "network": {
                    "type": "string"
                },
                "policy": {
                    "type": "object"
                },
                "purpose": {
                    "type": "string"
                },
                "service": {
                    "type": "string"
                }
            }
        },
        "key_storage.UpdatePolicyRequest": {
            "type": "object",
            "required": [
                "policy"
            ],
            "properties": {
                "policy": {
                    "type": "object"
                }
            }
        },
        "signing.SignTransactionRequest": {
            "type": "object",
            "required": [
                "network",
                "raw_tx"
            ],
            "properties": {
                "network": {
                    "type": "string"
                },
                "raw_tx": {
                    "description": "hex of unsigned tx: ethereum - types.Transaction.MarshalBinary, tron - raw_data_hex",
                    "type": "string"
                }
            }
        },
        "signing.SignTransactionResponse": {
            "type": "object",
            "properties": {
                "signed_tx": {
                    "description": "hex: ethereum - eth_sendRawTransaction, tron - /wallet/broadcasthex",
